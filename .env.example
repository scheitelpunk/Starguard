# SENTINEL Backend Environment Configuration
# Copy this file to .env and configure for your environment

# Server Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Security
API_KEY=your-secure-api-key-here
JWT_SECRET=your-jwt-secret-key-here

# Database
DB_PATH=./database/starguard.db
DB_ENCRYPTION=false
DB_ENCRYPTION_KEY=your-db-encryption-key

# AI/ML Configuration
AI_MODEL_PATH=./models/starguard-v1.onnx
QUANTUM_ENABLED=false

# Memory Management (8GB System Optimization)
MAX_HEAP_SIZE=6144
GC_INTERVAL=60000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# WebSocket Configuration
WS_MAX_CONNECTIONS=1000
WS_HEARTBEAT_INTERVAL=30000
WS_TIMEOUT=60000

# Performance Monitoring
METRICS_INTERVAL=10000
METRICS_RETENTION_DAYS=30

# Threat Detection
THREAT_SCAN_INTERVAL=30000
ALERT_COOLDOWN=300

# Production Settings (uncomment for production)
# NODE_ENV=production
# LOG_PRETTY=false
# CORS_ORIGINS=https://yourdomain.com
# API_KEY=prod-secure-key
# JWT_SECRET=prod-jwt-secret
# DB_ENCRYPTION=true
