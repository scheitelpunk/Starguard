{
  "name": "sentinel-enterprise-frontend",
  "version": "1.0.0",
  "description": "SENTINEL ENTERPRISE - Professional Security Platform with Advanced Threat Intelligence",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "NODE_ENV=production tsc && vite build --mode production",
    "preview": "vite preview",
    "serve": "vite preview --port 3000",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "clean": "rimraf dist",
    "prebuild": "npm run clean && npm run lint:check && npm run typecheck",
    "postbuild": "npm run test",
    "docker:build": "docker build -t starguard2-frontend .",
    "docker:run": "docker run -p 3000:80 starguard2-frontend",
    "security:audit": "npm audit --audit-level=moderate",
    "security:scan": "snyk test",
    "analyze": "npm run build && npx vite-bundle-analyzer dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "three": "^0.158.0",
    "@types/three": "^0.158.3",
    "react-three-fiber": "^6.0.13",
    "@react-three/drei": "^9.88.13",
    "@react-three/fiber": "^8.15.11",
    "framer-motion": "^10.16.5",
    "recharts": "^2.8.0",
    "d3": "^7.8.5",
    "@types/d3": "^7.4.3",
    "axios": "^1.6.2",
    "socket.io-client": "^4.7.4",
    "react-query": "^3.39.3",
    "@tanstack/react-query": "^5.8.4",
    "zustand": "^4.4.7",
    "jotai": "^2.5.1",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.14.18",
    "@mui/icons-material": "^5.14.18",
    "@mui/x-data-grid": "^6.18.2",
    "@mui/x-date-pickers": "^6.18.2",
    "styled-components": "^6.1.1",
    "react-hook-form": "^7.48.2",
    "@hookform/resolvers": "^3.3.2",
    "yup": "^1.3.3",
    "zod": "^3.22.4",
    "react-hot-toast": "^2.4.1",
    "react-helmet-async": "^1.3.0",
    "react-error-boundary": "^4.0.11",
    "react-intersection-observer": "^9.5.2",
    "react-virtualized-auto-sizer": "^1.0.20",
    "react-window": "^1.8.8",
    "@types/react-window": "^1.8.8",
    "lodash": "^4.17.21",
    "@types/lodash": "^4.14.202",
    "date-fns": "^2.30.0",
    "ramda": "^0.29.1",
    "@types/ramda": "^0.29.8",
    "uuid": "^9.0.1",
    "@types/uuid": "^9.0.7",
    "classnames": "^2.3.2",
    "clsx": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "vite": "^5.0.2",
    "vite-plugin-pwa": "^0.17.4",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-checker": "^0.6.2",
    "vite-bundle-analyzer": "^0.7.0",
    "typescript": "^5.3.2",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/user-event": "^14.5.1",
    "jest-canvas-mock": "^2.5.2",
    "jest-webgl-canvas-mock": "^2.5.2",
    "@playwright/test": "^1.40.0",
    "msw": "^2.0.8",
    "@storybook/addon-essentials": "^7.6.3",
    "@storybook/addon-interactions": "^7.6.3",
    "@storybook/addon-links": "^7.6.3",
    "@storybook/blocks": "^7.6.3",
    "@storybook/react": "^7.6.3",
    "@storybook/react-vite": "^7.6.3",
    "@storybook/testing-library": "^0.2.2",
    "storybook": "^7.6.3",
    "rimraf": "^5.0.5",
    "cross-env": "^7.0.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "tailwindcss": "^3.3.6",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "sass": "^1.69.5",
    "less": "^4.2.0",
    "stylus": "^0.62.0",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "snyk": "^1.1244.0",
    "bundlemon": "^2.1.0",
    "size-limit": "^11.0.1",
    "@size-limit/preset-app": "^11.0.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.{ts,tsx}",
      "**/?(*.)+(spec|test).{ts,tsx}"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts",
      "jest-canvas-mock",
      "jest-webgl-canvas-mock"
    ],
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "\\.(gif|ttf|eot|svg|png)$": "<rootDir>/tests/__mocks__/fileMock.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/types/**/*",
      "!src/**/*.interface.ts",
      "!src/**/*.stories.{ts,tsx}",
      "!src/main.tsx",
      "!src/vite-env.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "size-limit": [
    {
      "path": "dist/**/*.js",
      "limit": "500 KB"
    },
    {
      "path": "dist/**/*.css",
      "limit": "50 KB"
    }
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "react",
    "typescript",
    "vite",
    "three.js",
    "quantum-visualization",
    "security",
    "enterprise",
    "real-time",
    "monitoring",
    "dashboard",
    "3d-graphics",
    "webgl"
  ],
  "author": "Sentinel Enterprise Team",
  "license": "Commercial",
  "repository": {
    "type": "git",
    "url": "https://github.com/sentinel-enterprise/sentinel-platform.git"
  },
  "bugs": {
    "url": "https://github.com/sentinel-enterprise/sentinel-platform/issues"
  },
  "homepage": "https://sentinel-enterprise.io"
}