{
  "name": "sentinel-enterprise",
  "version": "1.0.0",
  "description": "SENTINEL ENTERPRISE - Enterprise-Grade Distributed Security Intelligence Platform",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "build": "npm run clean && npm run build:backend && npm run build:frontend && npm run copy-assets",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "node scripts/build-frontend.js",
    "copy-assets": "cp -r frontend/* dist/public/",
    "start": "npm run build && node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npx tsx --test tests/unit/**/*.test.js",
    "test:integration": "npx tsx --test tests/integration/**/*.test.js",
    "test:coverage": "c8 --config .c8rc.json npx tsx --test tests/**/*.test.js",
    "test:watch": "npx tsx --test --watch tests/**/*.test.js",
    "test:verbose": "npx tsx --test --test-reporter=spec tests/**/*.test.js",
    "test:backend": "npx tsx --test backend/tests/**/*.test.js",
    "test:ml": "python -m pytest ml/tests/ -v",
    "lint": "eslint backend/src/**/*.ts --fix",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json",
    "clean": "rm -rf dist && mkdir -p dist/public",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "health": "node scripts/healthcheck.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "logs": "tail -f logs/sentinel.log",
    "monitor": "node scripts/monitor.js",
    "install:ml": "cd ml && pip install -r requirements.txt",
    "prestart": "npm run migrate && npm run install:ml",
    "postinstall": "npm run install:ml || echo 'ML dependencies install failed, continuing...'",
    "consciousness:demo": "tsx examples/starguard-demo.ts",
    "consciousness:start": "tsx -e \"import('./backend/src/consciousness/index.js').then(m => m.initializeStarguardConsciousness())\"",
    "test:consciousness": "npx tsx --test tests/consciousness.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^8.1.0",
    "@fastify/static": "^6.12.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^8.3.1",
    "@sinclair/typebox": "^0.34.40",
    "big-integer": "^1.6.52",
    "crypto-js": "^4.2.0",
    "dgram": "^1.0.1",
    "dotenv": "^16.3.1",
    "events": "^3.3.0",
    "express": "^5.1.0",
    "fastify": "^4.29.1",
    "geoip-lite": "^1.4.10",
    "graceful-fs": "^4.2.11",
    "ioredis": "^5.7.0",
    "joi": "^17.12.0",
    "net": "^1.0.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "pino": "^10.1.0",
    "pino-pretty": "^10.3.1",
    "raw-socket": "^1.8.1",
    "redis": "^5.8.2",
    "sqlite3": "^5.1.6",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "ws": "^8.18.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@fastify/compress": "^8.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.0",
    "@opentelemetry/exporter-jaeger": "^2.2.0",
    "@opentelemetry/exporter-prometheus": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@types/big-integer": "^0.0.30",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.19.11",
    "@types/node-cron": "^3.0.11",
    "@types/redis": "^4.0.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "c8": "^8.0.1",
    "eslint": "^8.56.0",
    "js-yaml": "^4.1.1",
    "prom-client": "^15.1.3",
    "tar-fs": "^2.1.4",
    "terser": "^5.26.0",
    "tsx": "^4.20.5",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "security",
    "quantum",
    "consciousness",
    "threat-detection",
    "ml",
    "websocket",
    "real-time"
  ],
  "author": "STARGUARD Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/sentinel-enterprise.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/sentinel-enterprise/issues"
  },
  "homepage": "https://github.com/your-org/sentinel-enterprise#readme"
}
