/**
 * Threat Intelligence Query Interface
 */
interface ThreatIntelligenceQuery {
  readonly query_type: 'IOC_LOOKUP' | 'THREAT_ACTOR_SEARCH' | 'PATTERN_MATCH' | 'CONSCIOUSNESS_ANALYSIS' | 'QUANTUM_SIGNATURE' | 'MORPHIC_PATTERN';
  readonly query_parameters: Record<string, any>;
  readonly time_range?: { start: Date; end: Date };
  readonly consciousness_level_filter?: number;
  readonly quantum_authenticated_only?: boolean;
  readonly morphic_field_validated_only?: boolean;
  readonly privacy_level?: 'PUBLIC' | 'PRIVATE' | 'CONSORTIUM' | 'CONSCIOUSNESS_GATED';
}