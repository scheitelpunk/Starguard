# STARGUARD Development Environment Configuration
NODE_ENV=development
PORT=3000
WS_PORT=3001

# Database Configuration
DATABASE_URL=file:./data/starguard-dev.db
DATABASE_POOL_SIZE=3
DATABASE_TIMEOUT=30000

# Caching Configuration
CACHE_TYPE=memory
CACHE_TTL=60
CACHE_MAX_SIZE=50

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=logs/starguard-dev.log
LOG_MAX_SIZE=10mb
LOG_MAX_FILES=3
LOG_DATE_PATTERN=YYYY-MM-DD-HH

# Security Configuration
JWT_SECRET=dev-secret-do-not-use-in-production
RATE_LIMIT_MAX=10000
RATE_LIMIT_WINDOW=900000
CORS_ORIGINS=*

# ML Service Configuration
ML_SERVICE_URL=http://localhost:5000
ML_TIMEOUT=30000
ML_RETRIES=3

# Threat Feed Configuration
THREAT_FEEDS_ENABLED=true
THREAT_FEEDS_INTERVAL=60000
THREAT_FEEDS_TIMEOUT=10000

# Development specific
HOT_RELOAD=true
DEBUG=starguard:*
VERBOSE_LOGGING=true