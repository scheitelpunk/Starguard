# Production Environment Configuration Template
# Copy to .env.production and fill in actual values

# Application Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
API_VERSION=v1

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=your-strong-redis-password
REDIS_DB=0

# Database Configuration (if using external database)
DATABASE_URL=postgresql://user:password@localhost:5432/starguard
DATABASE_SSL=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Network Monitoring Configuration
MONITOR_INTERFACE=eth0
PCAP_FILTER=tcp or udp
PCAP_SNAPLEN=1518
PCAP_BUFFER_SIZE=2097152
PCAP_TIMEOUT=1000

# Security Configuration
JWT_SECRET=your-256-bit-secret-key
JWT_EXPIRES_IN=24h
API_KEY=your-api-key
ENCRYPTION_KEY=your-32-byte-encryption-key

# ML/AI Configuration
ANOMALY_THRESHOLD=0.75
ML_MODEL_PATH=/app/models
ML_UPDATE_INTERVAL=3600
QUANTUM_ENGINE_ENABLED=true
CONSCIOUSNESS_MODULE_ENABLED=true

# Threat Detection
THREAT_SCORE_THRESHOLD=0.8
AUTO_BLOCK_ENABLED=false
WHITELIST_ENABLED=true
BLACKLIST_ENABLED=true

# Alert Configuration
ENABLE_EMAIL_ALERTS=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=your-smtp-password
ALERT_EMAIL=security@yourcompany.com

ENABLE_SLACK_ALERTS=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

ENABLE_WEBHOOK_ALERTS=false
WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

# Monitoring and Metrics
ENABLE_METRICS=true
METRICS_PORT=9090
PROMETHEUS_ENDPOINT=/metrics
GRAFANA_ADMIN_PASSWORD=secure-grafana-password

# Docker Compose Overrides
NGINX_HOST=your-domain.com
GRAFANA_DOMAIN=metrics.your-domain.com

# SSL/TLS Configuration
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem
SSL_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESSFUL=true

# CORS Configuration
CORS_ORIGIN=https://your-frontend-domain.com
CORS_CREDENTIALS=true

# Session Configuration
SESSION_SECRET=your-session-secret
SESSION_TIMEOUT=1800

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=.pdf,.txt,.csv,.json

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Performance Tuning
NODE_OPTIONS=--max-old-space-size=2048 --enable-source-maps
UV_THREADPOOL_SIZE=4
NODE_MAX_CONCURRENT_REQUESTS=1000

# Development/Debug (should be false/disabled in production)
DEBUG=false
ENABLE_DEBUG_LOGS=false
ENABLE_PROFILING=false