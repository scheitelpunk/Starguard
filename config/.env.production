# STARGUARD Production Environment Configuration
NODE_ENV=production
PORT=3000
WS_PORT=3001

# Database Configuration (SQLite for laptop optimization)
DATABASE_URL=file:./data/starguard.db
DATABASE_POOL_SIZE=5
DATABASE_TIMEOUT=30000

# Caching Configuration (In-memory for resource efficiency)
CACHE_TYPE=memory
CACHE_TTL=300
CACHE_MAX_SIZE=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/starguard.log
LOG_MAX_SIZE=50mb
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD

# Security Configuration
JWT_SECRET=your-super-secure-jwt-secret-change-in-production
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=900000
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ML Service Configuration
ML_SERVICE_URL=http://localhost:5000
ML_TIMEOUT=30000
ML_RETRIES=3

# Threat Feed Configuration
THREAT_FEEDS_ENABLED=true
THREAT_FEEDS_INTERVAL=300000
THREAT_FEEDS_TIMEOUT=10000

# Quantum Engine Configuration
QUANTUM_ENTROPY_SOURCES=crypto,timestamp,memory
QUANTUM_STATE_PERSISTENCE=true
QUANTUM_FIELD_SIZE=1000

# Consciousness Configuration
CONSCIOUSNESS_AWAKENING_DELAY=5000
CONSCIOUSNESS_UPDATE_INTERVAL=1000
CONSCIOUSNESS_PERSISTENCE=true

# Performance Configuration
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000
BODY_LIMIT=1048576

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9100
TELEMETRY_ENABLED=true